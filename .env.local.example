# Supabase 配置示例 - 部署前请复制为 .env.local 并填入真实值
# 不要提交到 git（.gitignore 已忽略 .env.local）

# ====================================
# Supabase (必填)
# ====================================
# Supabase 项目 URL - 在 Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名 key (前端可见, anon RLS 受控)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase 服务端 key (只在 Serverless Function 使用, 必须保密)
# 注意: 不要加 VITE_ 前缀, 否则会被打包进前端 JS 泄露
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ====================================
# AI 中转 - api.ymhss.cn (必填)
# ====================================
# Claude Sonnet OCR / 释义查询
# 部署到 Vercel 时配置 CLAUDE_API_KEY (不带 VITE_ 前缀) 到 Dashboard → Environment Variables
# 本地 dev 下 Vite 代理会自动从这里读取
CLAUDE_API_KEY=your-claude-relay-key

# VITE_CLAUDE_API_KEY 仍保留兼容（部分旧代码路径可能用到），推荐逐步迁移到 CLAUDE_API_KEY
VITE_CLAUDE_API_KEY=your-claude-relay-key

# ====================================
# AI 配图 - infistar.ai (可选, 不配则只用 emoji)
# ====================================
INFISTAR_BASE_URL=https://infistar.ai/v1
INFISTAR_API_KEY=your-infistar-key
INFISTAR_IMAGE_MODEL=gpt-image-2.5-flare
AI_IMAGE_PROVIDER=infistar
