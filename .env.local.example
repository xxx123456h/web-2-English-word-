# Supabase 配置示例 - 部署前请复制为 .env.local 并填入真实值
# 不要提交到 git（.gitignore 已忽略 .env.local）

# ====================================
# Supabase (必填)
# ====================================
# Supabase 项目 URL - 在 Project Settings -> API -> Project URL
VITE_SUPABASE_URL=https://your-project.supabase.co

# Supabase 匿名 key (前端可见, anon RLS 受控)
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase 服务端 key (只在 Serverless Function 使用, 必须保密)
# 注意: 不要加 VITE_ 前缀, 否则会被打包进前端 JS 泄露
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ====================================
# AI 中转 - infistar.ai (必填)
# ====================================
# 拍照 OCR / 释义查询 / 场景生成 / AI 配图共用同一个 Key
# 部署到 Vercel 时配置 INFISTAR_API_KEY (不带 VITE_ 前缀) 到 Dashboard → Environment Variables
# 本地 dev 下 Vite 代理和 api/ 函数会自动从这里读取
# INFISTAR_BASE_URL 写 https://infistar.ai 或 https://infistar.ai/v1 均可
INFISTAR_BASE_URL=https://infistar.ai/v1
INFISTAR_API_KEY=your-infistar-key
INFISTAR_IMAGE_MODEL=gemini-3.1-flash-lite-image
AI_IMAGE_PROVIDER=infistar
